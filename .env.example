# Copy to .env (gitignored) for scripts/publish-examples.sh and scripts/cleanup-examples.sh.
# Connected app (client credentials) with Exchange Contributor in the target business group.
ANYPOINT_CLIENT_ID=
ANYPOINT_CLIENT_SECRET=
# Business group that receives the example assets (also used as the Exchange group ID).
ANYPOINT_ORG_ID=
# Control plane: anypoint.mulesoft.com (US), eu1.anypoint.mulesoft.com (EU), gov.anypoint.mulesoft.com (Gov).
ANYPOINT_HOST=anypoint.mulesoft.com
# Optional: version for every example asset, and the asset ID prefix (defaults to exchange.json assetId).
EXAMPLES_VERSION=1.0.0
# EXAMPLES_PREFIX=
